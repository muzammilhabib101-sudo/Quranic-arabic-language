َامَنُواْ ثُمَّ كَفَرُواْ فَطُبِعَ عَلَىٰ قُلُوبِهِمۡ فَهُمۡ لَا يَفۡقَهُونَ ٣","t":{"en":"That is because they believed, and then they disbelieved; so their hearts were sealed over, and they do not understand.","ur":"یہ اس لئے کہ یہ (پہلے تو) ایمان لائے پھر کافر ہوگئے تو ان کے دلوں پر مہر لگادی گئی۔ سو اب یہ سمجھتے ہی نہیں"},"w":[{"p":1,"ar":"ذَٰلِكَ","u":"ذَٰلِكَ","tl":"dhālika","en":"That","ur":"یہ","role":"noun","root":null,"lemma":"ذا","seg":[{"t":"ذَٰ","pos":"N","tags":"DEM|LEM:ذا|MS"},{"t":"لِ","pos":"P","tags":"DIST|SUFF|LEM:ل"},{"t":"كَ","pos":"P","tags":"ADDR|SUFF|M"}]},{"p":2,"ar":"بِأَنَّهُمۡ","u":"بِأَنَّهُمْ","tl":"bi-annahum","en":"(is) because","ur":"بوجہ اس کے کہ بیشک وہ","role":"particle","root":null,"lemma":"أَنّ","seg":[{"t":"بِ","pos":"P","tags":"P|PREF|LEM:ب"},{"t":"أَنَّ","pos":"P","tags":"ACC|LEM:أَنّ|FAM:إِنّ"},{"t":"هُمْ","pos":"N","tags":"PRON|SUFF|3MP"}]},{"p":3,"ar":"ءَامَنُواْ","u":"ءَامَنُوا۟","tl":"āmanū","en":"they believed","ur":"ایمان لائے","role":"verb","root":"أمن","lemma":"آمَنَ","seg":[{"t":"ءَامَنُ","pos":"V","tags":"PERF|VF:4|ROOT:أمن|LEM:آمَنَ|3MP"},{"t":"وا۟","pos":"N","tags":"PRON|SUFF|3MP"}]},{"p":4,"ar":"ثُمَّ","u":"ثُمَّ","tl":"thumma","en":"then","ur":"پھر","role":"particle","root":null,"lemma":"ثُمّ","seg":[{"t":"ثُمَّ","pos":"P","tags":"CONJ|LEM:ثُمّ"}]},{"p":5,"ar":"كَفَرُواْ","u":"كَفَرُوا۟","tl":"kafarū","en":"they disbelieved","ur":"انہوں نے کفر کیا","role":"verb","root":"كفر","lemma":"كَفَرَ","seg":[{"t":"كَفَرُ","pos":"V","tags":"PERF|VF:1|ROOT:كفر|LEM:كَفَرَ|3MP"},{"t":"وا۟","pos":"N","tags":"PRON|SUFF|3MP"}]},{"p":6,"ar":"فَطُبِعَ","u":"فَطُبِعَ","tl":"faṭubiʿa","en":"so were sealed","ur":"تو مہر لگا دی گئی","role":"verb","root":"طبع","lemma":"طَبَعَ","seg":[{"t":"فَ","pos":"P","tags":"CAUS|PREF|LEM:ف"},{"t":"طُبِعَ","pos":"V","tags":"PERF|VF:1|PASS|ROOT:طبع|LEM:طَبَعَ|3MS"}]},{"p":7,"ar":"عَلَىٰ","u":"عَلَىٰ","tl":"ʿalā","en":"[upon]","ur":"اوپر","role":"particle","root":null,"lemma":"عَلَى","seg":[{"t":"عَل